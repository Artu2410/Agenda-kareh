# ========================================
# CONFIGURACIÓN DE GOOGLE OAUTH 2.0
# ========================================
# Pasos para obtener las credenciales:
# 1. Ve a https://console.cloud.google.com
# 2. Crea un nuevo proyecto o selecciona uno existente
# 3. Habilita la API de Google+ (o "People API")
# 4. Va a "Credenciales" y crea una nueva credencial: "OAuth 2.0 ID de Cliente"
# 5. Selecciona "Aplicación web"
# 6. En "Orígenes autorizados" agrega:
#    - http://localhost:3000
#    - http://localhost:5000
#    - http://localhost:5173
#    - https://tu-dominio.com (cuando despliegues)
# 7. En "URIs de redirección autorizados" agrega:
#    - http://localhost:5000/api/auth/callback
#    - http://localhost:5173/auth/callback
#    - https://tu-dominio.com/auth/callback (cuando despliegues)
# 8. Copia el Client ID y Client Secret y pégalos aquí:

GOOGLE_CLIENT_ID=tu_google_client_id_aqui
GOOGLE_CLIENT_SECRET=tu_google_client_secret_aqui

# ========================================
# CONFIGURACIÓN DE JWT
# ========================================
JWT_SECRET=tu_jwt_secret_super_seguro_aqui_min_32_caracteres
JWT_REFRESH_SECRET=tu_refresh_secret_super_seguro_aqui_min_32_caracteres
REFRESH_TOKEN_SECRET=tu_refresh_secret_super_seguro_aqui_min_32_caracteres
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
AUTH_HASH_PEPPER=pepper_adicional_para_tokens
OTP_PEPPER=pepper_adicional_para_otp
OTP_EXPIRES_IN=15m
MAX_OTP_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=30

# ========================================
# GOOGLE GEMINI (Transcripcion)
# ========================================
GEMINI_API_KEY=tu_api_key_de_gemini
GEMINI_MODEL=gemini-1.5-flash-002
GEMINI_AUDIO_MODEL=gemini-1.5-flash-002

# ========================================
# PUERTO DEL SERVIDOR
# ========================================
PORT=5000

# ========================================
# BASE DE DATOS (Ya existente)
# ========================================
DATABASE_URL=postgresql://neondb_owner:npg_************@ep-empty-band-aiyzwi0n.c-4.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ========================================
# EMAIL AUTORIZADO
# ========================================
AUTHORIZED_EMAIL=centrokareh@gmail.com
AUTHORIZED_USER_NAME=Administrador
# Alternativa recomendada para múltiples usuarios:
# AUTH_BOOTSTRAP_USERS=[{"email":"admin@kareh.com","fullName":"Admin Kareh","role":"ADMIN"},{"email":"doctor@kareh.com","fullName":"Dra. Demo","role":"DOCTOR"}]
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=Kareh Salud


# ========================================
# ENTORNO
# ========================================
APP_VERSION=2026.05.28-rc1
COMMIT_SHA=cb5f418
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173
COOKIE_SECURE=false
# Orígenes extra separados por coma para CORS en producción
# Ejemplo: https://agenda-kareh.vercel.app,https://mi-preview.vercel.app
CORS_ALLOWED_ORIGINS=

# ========================================
# STORAGE LOCAL
# ========================================
# Almacenamiento local replicado externamente con Syncthing
UPLOADS_DIR=./uploads
# URL del backend de esta PC, por ejemplo http://localhost:5000 o http://100.64.x.x:5000
PUBLIC_SERVER_URL=http://localhost:5000
# Si se usa el respaldo local descargado desde AWS (ejecución desde server/):
# UPLOADS_DIR=../Backup_AWS_Kareh/kareh-uploads
# Tamaño máximo de archivo (MB)
UPLOAD_MAX_MB=25
TRANSCRIPTION_MAX_MB=8

# ========================================
# COKIBA SCRAPER (Obras Sociales)
# ========================================
# Credenciales opcionales para autogestion.cokiba.org.ar
# La pantalla de obras sociales puede sincronizar en modo publico.
COKIBA_DNI=tu_dni_aqui
COKIBA_CLAVE=tu_clave_aqui
# Plazo de pago en días (default: 60)
COKIBA_PLAZO_PAGO=60
# Email destino para alertas del sync COKIBA
KAREH_ALERT_EMAIL=centrokareh@gmail.com
# Cron diario automático de COKIBA
COKIBA_DAILY_SYNC_ENABLED=true
COKIBA_DAILY_SYNC_TIME=03:15
COKIBA_CRON_TOKEN=token_secreto_cokiba

# Zona horaria para cron
TZ=America/Argentina/Buenos_Aires

# (No incluir llaves reales en este archivo)
